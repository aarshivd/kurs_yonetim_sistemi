# ─── WhatsApp Bot (Meta Cloud API) ───────────────────────────────────────────
# Bu dosyayı .env olarak kopyala ve değerleri doldur:
#   cp .env.example .env
# .env asla git'e eklenmez (.gitignore'da tanımlı).
#
# Meta Developer Panel'den (developers.facebook.com) uygulama oluşturup
# WhatsApp ürününü ekleyerek aşağıdaki değerleri al.

# Meta'nın verdiği Geçici (veya Kalıcı) Erişim Simgesi (Access Token)
WA_ACCESS_TOKEN=BURAYA_META_ACCESS_TOKEN

# WhatsApp API Setup sayfasındaki "Telefon Numarası Kodu" (Phone Number ID)
WA_PHONE_NUMBER_ID=BURAYA_PHONE_NUMBER_ID

# Webhook doğrulaması için kendi belirlediğin rastgele bir şifre.
# Meta paneline webhook eklerken bu değeri "Verify Token" alanına yaz.
WA_VERIFY_TOKEN=RASTGELE-GUCLU-BIR-SIFRE
